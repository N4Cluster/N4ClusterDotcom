{
  "name": "N4Cluster",
  "northStar": "The Neighborhood Ledger",
  "source": "app/globals.css @theme; mirrors DESIGN.md frontmatter",
  "colors": {
    "cream": "#F7F3EA",
    "cream-2": "#F2EEE4",
    "cream-3": "#E8E1D2",
    "line": "#E4DCCB",
    "ink": "#0F1A3A",
    "ink-2": "#26335E",
    "ink-3": "#3A4570",
    "muted": "#5A6080",
    "muted-2": "#4A5170",
    "gold": "#F4B33E",
    "green": "#1F7A4D",
    "green-deep": "#155A38",
    "green-tint": "#EAF5EE",
    "red": "#B8371F",
    "white": "#FFFFFF"
  },
  "typography": {
    "display": "Bricolage Grotesque",
    "body": "Inter",
    "fallback": "ui-sans-serif, system-ui, -apple-system, sans-serif"
  },
  "radius": {
    "button": "9999px",
    "chip": "10px",
    "card": "22px",
    "panel": "32px"
  },
  "shadows": {
    "button-rest": "0 1px 2px 0 rgba(0,0,0,0.05)",
    "card-hover": "0 20px 40px -12px rgba(4,13,28,0.15)",
    "mockup": "0 30px 60px rgba(15,26,58,0.35)"
  },
  "focus": {
    "default": "2px solid ink",
    "on-dark": "white",
    "on-light": "ink"
  },
  "logoOnly": {
    "teal": "#14b8a6"
  }
}
